# Capa Node de AS02, encima de la imagen PHP. No regenera package-lock ni hace npm install -g npm.
FROM gelianv-sail:php-8.4.27

USER root

ARG NODE_VERSION=24.22.1

RUN arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
        amd64) node_arch=x64 ;; \
        arm64) node_arch=arm64 ;; \
        *) echo "arquitectura no soportada: $arch" >&2; exit 1 ;; \
    esac \
    && curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" \
    && curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" \
    && grep " node-v${NODE_VERSION}-linux-${node_arch}.tar.xz$" SHASUMS256.txt | sha256sum -c - \
    && tar -xJf "node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" -C /usr/local --strip-components=1 \
    && rm -f SHASUMS256.txt "node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" \
    && node -v | grep -qx "v${NODE_VERSION}" \
    && command -v npm >/dev/null
