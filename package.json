{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node scripts/retain-vite-assets.mjs",
        "dev": "vite",
        "test": "vitest run",
        "test:watch": "vitest",
        "check:style-jsx": "bash scripts/style-guard/check-jsx-no-hex.sh --check",
        "check:style-css": "bash scripts/style-guard/check-css-features-no-hex.sh --check",
        "check:style": "npm run check:style-jsx && npm run check:style-css",
        "check:style-jsx:baseline": "bash scripts/style-guard/check-jsx-no-hex.sh --update-baseline",
        "check:style-css:baseline": "bash scripts/style-guard/check-css-features-no-hex.sh --update-baseline",
        "lint:style-css": "stylelint \"resources/css/gelia/features/**/*.css\""
    },
    "devDependencies": {
        "@laravel/echo-react": "^2.3.3",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "happy-dom": "^20.14.0",
        "laravel-echo": "^2.3.4",
        "laravel-vite-plugin": "^3.0.0",
        "pusher-js": "^8.5.0",
        "stylelint": "^16.25.0",
        "stylelint-config-standard": "^39.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@inertiajs/react": "^3.0.3",
        "@react-google-maps/api": "^2.20.8",
        "@simplewebauthn/browser": "^14.0.0",
        "@vitejs/plugin-react": "^6.0.1",
        "animejs": "^4.4.1",
        "axios": "^1.16.0",
        "html5-qrcode": "^2.3.8",
        "lottie-react": "^2.4.1",
        "lucide-react": "^1.14.0",
        "perfect-freehand": "^1.2.3",
        "react": "^19.2.5",
        "react-dom": "^19.2.5"
    }
}
